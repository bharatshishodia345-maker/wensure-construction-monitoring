# WENSURE Construction Accountability Platform
# Environment Configuration

APP_NAME="WENSURE API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# Default: zero-configuration SQLite for instant local execution
# For PostgreSQL: postgresql+asyncpg://wensure:wensure_secret@localhost:5432/wensure_db
DATABASE_URL="sqlite+aiosqlite:///./wensure.db"

# Security & JWT
JWT_SECRET="wensure_super_secret_development_key_change_in_production_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
