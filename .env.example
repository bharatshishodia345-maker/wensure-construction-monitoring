# WENSURE Construction Accountability Platform
# Environment Configuration Example

APP_NAME="WENSURE API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (Resolved deterministically relative to project root)
# Default: zero-configuration SQLite for instant local execution
# For PostgreSQL: postgresql+asyncpg://wensure:wensure_secret@localhost:5432/wensure_db
DATABASE_URL="sqlite+aiosqlite:///./wensure.db"

# Security & JWT (Must be at least 32 characters in production)
JWT_SECRET="wensure_dev_secret_key_8f3c7a912e5b4d6a8f1e2c3d4b5a6"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# Frontend Environment Variables
VITE_API_BASE_URL="http://localhost:8000/api/v1"
